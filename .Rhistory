m_t3col1 <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played),
data    = table3_col1,
family  = bernoulli(link = "logit"),
prior   = priors_t3c1,
iter    = 4000, warmup = 2000, chains = 4, cores = 4
)
summary(m_t3col1)
pp_check(m_t3col1, ndraws = 100)
#conditional_effects(m_t3col1, spaghetti = TRUE, ndraws = 200)
plot(m_t3col1)
cor(table3_col1 %>% select(teamdist_c, oppdist_c, distance_ratio_c, total_distance_c), use = "pairwise.complete.obs")
priors_t3c2 <- c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 1)", class = "b", coef = "teamdist_c"),
set_prior("normal(0, 1)", class = "b", coef = "oppdist_c"),
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c")
)
m_t3col2 <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col2,
#sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c2,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
summary(m_t3col2)
#plot(m_t3col2)
pp_check(m_t3col2, ndraws = 100)
priors_t3c3 <- c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 1)", class = "b", coef = "teamdist_c"),
set_prior("normal(0, 1)", class = "b", coef = "oppdist_c"),
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c"),
set_prior("normal(0, 0.3)", class = "b", coef = "team_crowd_c"),
set_prior("normal(0, 0.3)", class = "b", coef = "opp_crowd_c"),
set_prior("normal(0, 2)", class = "b", coef = "p_odds_team_c"),
set_prior("normal(0, 3)", class = "b", coef = "p_odds_draw_c")
)
m_t3col3 <- brm(
dteamwin ~
teamdist_c +
oppdist_c +
team_crowd_c +
opp_crowd_c +
p_odds_team_c +
p_odds_draw_c +
(1 | pair) +
(1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col3,
#sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c3,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
summary(m_t3col3)
#plot(m_t3col3)
pp_check(m_t3col3, ndraws = 100)
priors_t3c4 <- c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 1)", class = "b", coef = "teamdist_c"),
set_prior("normal(0, 1)", class = "b", coef = "oppdist_c"),
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c")
)
m_t3col4 <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col4,
#sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c4,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
summary(m_t3col4)
#plot(m_t3col4)
pp_check(m_t3col4, ndraws = 100)
priors_t3c5 <-c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c"),
set_prior("normal(0, 1)", class = "b", coef = "distance_ratio_c") # wider priors (normal 0, 2-3) produce results close to paper, otherwise effect is shrunk towards zero
)
m_t3col5 <- brm(
dteamwin ~ distance_ratio_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col5,
#sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c5,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
pp_check(m_t3col5, ndraws = 100)
summary(m_t3col5)
#pp_check(m_t3col5, ndraws = 100)
#conditional_effects(m_t3col1, spaghetti = TRUE, ndraws = 200)
#plot(m_t3col5)
priors_t3c6 <-c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c"),
set_prior("normal(0, 0.1)", class = "b", coef = "distance_ratio_c"),
set_prior("normal(0, 1)", class = "b", coef = "total_distance_c")
)
m_t3col6 <- brm(
dteamwin ~ distance_ratio_c + total_distance_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col6,
#sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c6,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
summary(m_t3col6)
#plot(m_t3col6)
pp_check(m_t3col6, ndraws = 100)
m_t3col1_prior <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played),
data = table3_col1,
family = bernoulli(link = "logit"),
#sample_prior = "only",
prior = priors_t3c1,
iter = 4000, warmup = 200, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
