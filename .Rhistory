library(tidyverse)
library(haven)
library(ggplot2)
library(dplyr)
library(plotly)
library(tidyr)
library(xtable)
library(knitr)
library(kableExtra)
library(tidybayes)
library(brms)
library(bayesplot)
library(posterior)
library(dagitty)
library(ggdag)
data <- read_dta("original&computed_DB_forrep.dta")
data_base <- data %>%
filter(
dfullsection == 1,          # full sections only
position %in% c(3, 4),      # midfielders + strikers
!(section %in% c(10, 20))
)
data_base <- data_base  %>% mutate(player = factor(player),
gamenu = factor(gamenu),
section = factor(section))
data_base <- data_base %>%
mutate(
SMGP = ifelse(position %in% c(3,4),          # SMGP = Strikers and midfielders goal probability
dplagoal,                      # already 0/1 if player scored
NA)                            # set others to NA
)
# unique combinations of team and games
TG_combinations <- data_base %>%
distinct(team, gamenu) %>%
nrow()
TG_combinations
team_game_redcards <- data_base %>%
group_by(team, gamenu) %>%
summarise(
redcard_teamgame = as.integer(any(dplaredc == 1)),
.groups = "drop"
)
data_col1 <- data_base %>%
drop_na(dplagoal, plaavspeed) %>%
mutate(
plaavspeed_c = plaavspeed - mean(plaavspeed, na.rm = TRUE)
)
data_col1s <- data_base %>%
drop_na(dplagoal, plaavspeed) %>%
mutate(
plaavspeed_s = scale(plaavspeed, na.rm = TRUE)
)
data_col1s <- data_base %>%
drop_na(dplagoal, plaavspeed) %>%
mutate(
plaavspeed_s = scale(plaavspeed)
)
priors_fixef_base <- c(
set_prior("normal(-4.6, 0.3)", class = "Intercept"),
set_prior("normal(0, 0.4)",   class = "b")
)
priors_fixef_col1 <- c(
priors_fixef_base,
set_prior("normal(0, 0.4)", class = "b", coef = "plaavspeed_c")
)
View(priors_fixef_col1)
View(priors_fixef_base)
View(data_col1s)
data_col1s <- data_base %>%
drop_na(dplagoal, plaavspeed) %>%
mutate(
plaavspeed_s = scale(plaavspeed)
)
data_col1s %>% select(plaavspeed_s)
data_col1s %>% summary(plaavspeed_s)
summary(data_col1s$plaavspeed_s)
sd(data_col1s$plaavspeed_s)
sd(data_col1s$plaavspeed)
sd(data_col1s$plaavspeed) * 0.4
m_col1_s <- brm(
dplagoal ~ plaavspeed_s +
factor(player) +
factor(gamenu) +
factor(section),
data    = data_col1s,
family  = bernoulli(link = "logit"),
#sample_prior = "only",
prior   = c( prior(normal(-4.6, 0.3), class = "Intercept"),
prior(normal(0, 0.4), class = "b"),
prior(normal(0, 0.4681233), class = "b", coef = "plaavspeed_s")),
iter    = 1000, warmup = 500, chains = 4, cores = 4
)
m_col1_s <- brm(
dplagoal ~ plaavspeed_s +
factor(player) +
factor(gamenu) +
factor(section),
data    = data_col1s,
family  = bernoulli(link = "logit"),
#sample_prior = "only",
prior   = c( prior(normal(-4.6, 0.3), class = "Intercept"),
prior(normal(0, 0.4), class = "b"),
prior(normal(0, 0.4681233), class = "b", coef = "plaavspeed_s")),
iter    = 1000, warmup = 500, chains = 4, cores = 4
)
