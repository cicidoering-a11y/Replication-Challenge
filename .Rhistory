#set weakly informative priors that fit logit scale
priors_t3c1 <- c(
set_prior("normal(-0.4, 1)", class = "Intercept"),
set_prior("normal(0, 1)", class = "b", coef = "teamdist_c"),
set_prior("normal(0, 1)", class = "b", coef = "oppdist_c")
)
m_t3col1_prior <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played),
data = table3_col1,
family = bernoulli(link = "logit"),
sample_prior = "only",
prior = priors_t3c1,
iter = 4000, warmup = 200, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
#prior checks
pp_check(m_t3col1_prior, ndraws = 100)
yrep_small <- posterior_predict(m_t3col1_prior, ndraws = 100)
hist(rowMeans(yrep_small))
plot(m_t3col1_prior, N = 1000)
library(loo)
#gibt es einen workaround für die unterschiedlich großen sample sizes? loo braucht gleiche observation counts
# compute LOO objects
loo_t3c1 <- loo(m_t3col1)
loo_t3c2 <- loo(m_t3col2)
loo_t3c3 <- loo(m_t3col3)
loo_t3c4 <- loo(m_t3col4)
loo_t3c5 <- loo(m_t3col5)
loo_t3c6 <- loo(m_t3col6)
# compare models
loo_compare(
loo_t3c1,
loo_t3c2,
# loo_t3c3, 180 obs
# loo_t3c4, 152 ob
loo_t3c5,
loo_t3c6
)
