data    = table3_col6,
family  = bernoulli(link = "logit"),
prior   = priors_t3c6,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
priors_t3c6 <-c(
set_prior("normal(0, 0.5)",  class = "b", coef = "dhomegame"),
set_prior("normal(0, 0.3)", class = "b", coef = "rank_gap_c"),
set_prior("normal(0, 2)", class = "b", coef = "distance_ratio_c"),
set_prior("normal(0, 0.5)", class = "b", coef = "total_distance_c")
)
m_t3col6 <- brm(
dteamwin ~ distance_ratio_c + total_distance_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col6,
sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c6,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
summary(m_t3col6)
#plot(m_t3col6)
pp_check(m_t3col6, ndraws = 100)
summary(table3_col6)
priors_t3c6 <-c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.25)",  class = "b", coef = "dhomegame"),
#we are saying that playing a home game or not changes the base probability of winnig to be between ( 0.27, 0.505), 27% to 50%
set_prior("normal(0, 0.025)", class = "b", coef = "rank_gap_c"),
#We are saying that being 13 ranks above your opponent compared to being 13 ranks under changes the odd around (0.14 , 0.69) from 14% to 69%.
set_prior("normal(0, 4.25)", class = "b", coef = "distance_ratio_c"), # wider priors (normal 0, 2-3) produce results close to paper, otherwise effect is shrunk towards zero
# Wide weakly informative prior for our target variable. The ratio only moves by maximaly 0.28 units, so this wide prior allows the effect to be between (0.05 and 0.86) so between 5% and 86%.
set_prior("normal(0, 0.5)", class = "b", coef = "total_distance_c")
)
beta_from_p(0.7,-0.48,5977)
p_from_beta(-0.48,0.0002,5977)
p_from_beta(-0.48,-0.0002,5977)
priors_t3c6 <-c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.25)",  class = "b", coef = "dhomegame"),
#we are saying that playing a home game or not changes the base probability of winnig to be between ( 0.27, 0.505), 27% to 50%
set_prior("normal(0, 0.025)", class = "b", coef = "rank_gap_c"),
#We are saying that being 13 ranks above your opponent compared to being 13 ranks under changes the odd around (0.14 , 0.69) from 14% to 69%.
set_prior("normal(0, 4.25)", class = "b", coef = "distance_ratio_c"), # wider priors (normal 0, 2-3) produce results close to paper, otherwise effect is shrunk towards zero
# Wide weakly informative prior for our target variable. The ratio only moves by maximaly 0.28 units, so this wide prior allows the effect to be between (0.05 and 0.86) so between 5% and 86%.
set_prior("normal(0, 0.0001)", class = "b", coef = "total_distance_c")
# Having run 52316 compared to having run 40158 can change probability to be between (0.15, 0.67) 15% and 67%
)
priors_t3c6 <-c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.25)",  class = "b", coef = "dhomegame"),
#we are saying that playing a home game or not changes the base probability of winnig to be between ( 0.27, 0.505), 27% to 50%
set_prior("normal(0, 0.025)", class = "b", coef = "rank_gap_c"),
#We are saying that being 13 ranks above your opponent compared to being 13 ranks under changes the odd around (0.14 , 0.69) from 14% to 69%.
set_prior("normal(0, 4.25)", class = "b", coef = "distance_ratio_c"), # wider priors (normal 0, 2-3) produce results close to paper, otherwise effect is shrunk towards zero
# Wide weakly informative prior for our target variable. The ratio only moves by maximaly 0.28 units, so this wide prior allows the effect to be between (0.05 and 0.86) so between 5% and 86%.
set_prior("normal(0, 0.0001)", class = "b", coef = "total_distance_c")
# Having run 52316 compared to having run 40158 can change probability to be between (0.15, 0.67) 15% and 67%
)
m_t3col6 <- brm(
dteamwin ~ distance_ratio_c + total_distance_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col6,
sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c6,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
