priors_t3c5 <-c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.25)",  class = "b", coef = "dhomegame"),
#we are saying that playing a home game or not changes the base probability of winnig to be between ( 0.27, 0.505), 27% to 50%
set_prior("normal(0, 0.025)", class = "b", coef = "rank_gap_c"),
#We are saying that being 13 ranks above your opponent compared to being 13 ranks under changes the odd around (0.14 , 0.69) from 14% to 69%.
set_prior("normal(0, 4.25)", class = "b", coef = "distance_ratio_c") # wider priors (normal 0, 2-3) produce results close to paper, otherwise effect is shrunk towards zero
# Wide weakly informative prior for our target variable. The ratio only moves by maximaly 0.28 units, so this wide prior allows the effect to be between (0.05 and 0.86) so between 5% and 86%.
)
