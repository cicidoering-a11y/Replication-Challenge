priors_t3c2 <- c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.0001)", class = "b", coef = "teamdist_c"),
# we are saying that a team that runs 26.649 compared to a team that runs 19.426 will change the probability of winning between (0.12 , 0.72 ) so from 12% to 72%
set_prior("normal(0, 0.0001)", class = "b", coef = "oppdist_c"),
# we are saying that a team whose opponent runs 26.515 compared to a team that runs 20.514 will change the probability of winning between (0.15 , 0.67 ) so from 15% to 67%
set_prior("normal(0, 0.25)",  class = "b", coef = "dhomegame"),
#we are saying that playing a home game or not changes the base probability of winnig to be between ( 0.27, 0.505), 27% to 50%
set_prior("normal(0, 0.025)", class = "b", coef = "rank_gap_c")
#We are saying that being 13 ranks above your opponent compared to being 13 ranks under changes the odd around (0.14 , 0.69) from 14% to 69%.
)
m_t3col2 <- brm(
dteamwin ~ teamdist_c + oppdist_c + (1 | pair) + (1 | played) +
dhomegame +
rank_gap_c,
data    = table3_col2,
sample_prior = "only",
family  = bernoulli(link = "logit"),
prior   = priors_t3c2,
iter    = 4000, warmup = 2000, chains = 4, cores = 4,
control = list(max_treedepth = 15, adapt_delta = 0.95) #increase treedepth to avoid problems during warmup
)
#summary(m_t3col2)
#plot(m_t3col2)
pp_check(m_t3col2, ndraws = 100)
