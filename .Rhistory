#set weakly informative priors that fit logit scale
priors_t3c1 <- c(
set_prior("normal(-0.48, 1.23)", class = "Intercept"), # 38% baseline chance, 95% of values will be between [0.05, 0.95], this is wider than the BO range of 6% to 77%
set_prior("normal(0, 0.0001)", class = "b", coef = "teamdist_c"),
# we are saying that a team that runs 26.649 compared to a team that runs 19.426 will change the probability of winning between (0.12 , 0.72 ) so from 12% to 72%
set_prior("normal(0, 0.0001)", class = "b", coef = "oppdist_c")
# we are saying that a team whose opponent runs 26.515 compared to a team that runs 20.514 will change the probability of winning between (0.15 , 0.67 ) so from 15% to 67%
)
summary(table3_col2)
# function to check the p given a chosen coefficient and given intercept alpha
p_from_beta <- function(alpha, beta, x) {
exp(alpha + beta * x) / (1 + exp(alpha + beta * x))
}
# function to get the coefficient beta based on desired p given an intercept alpha
beta_from_p <- function(p, alpha, x, eps = 1e-12) {
# Basic checks
if (any(is.na(p) | is.na(alpha) | is.na(x))) stop("Inputs contain NA.")
if (any(p <= 0 | p >= 1)) stop("p must be strictly between 0 and 1.")
if (any(abs(x) < eps)) stop("x must be non-zero (cannot divide by ~0).")
# logit(p) = log(p/(1-p))
logit_p <- log(p / (1 - p))
(logit_p - alpha) / x
}
